{
  "name": "@arki/icons",
  "version": "0.2.1",
  "description": "Icon sets for ARKI apps — Iconify, Phosphor, Simple Icons and flag packs behind one React entry point.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "typescript",
    "react",
    "icons",
    "iconify",
    "phosphor"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "browser": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./flags": {
      "types": "./dist/src/flags/index.d.ts",
      "import": "./dist/src/flags/index.js",
      "browser": "./dist/src/flags/index.js",
      "default": "./dist/src/flags/index.js"
    },
    "./brands": {
      "types": "./dist/src/brands/index.d.ts",
      "import": "./dist/src/brands/index.js",
      "browser": "./dist/src/brands/index.js",
      "default": "./dist/src/brands/index.js"
    },
    "./phosphor": {
      "types": "./dist/src/phosphor.d.ts",
      "import": "./dist/src/phosphor.js",
      "browser": "./dist/src/phosphor.js",
      "default": "./dist/src/phosphor.js"
    },
    "./phosphor/ssr": {
      "types": "./dist/src/phosphor-ssr.d.ts",
      "import": "./dist/src/phosphor-ssr.js",
      "browser": "./dist/src/phosphor-ssr.js",
      "default": "./dist/src/phosphor-ssr.js"
    },
    "./phosphor/defaults": {
      "types": "./dist/src/phosphor-defaults.d.ts",
      "import": "./dist/src/phosphor-defaults.js",
      "browser": "./dist/src/phosphor-defaults.js",
      "default": "./dist/src/phosphor-defaults.js"
    },
    "./vite": {
      "types": "./dist/src/vite.d.ts",
      "default": "./dist/src/vite.js"
    },
    "./spinners": {
      "types": "./dist/src/spinners/index.d.ts",
      "import": "./dist/src/spinners/index.js",
      "browser": "./dist/src/spinners/index.js",
      "default": "./dist/src/spinners/index.js"
    },
    "./brands/index": {
      "types": "./dist/src/brands/index.d.ts",
      "import": "./dist/src/brands/index.js",
      "browser": "./dist/src/brands/index.js",
      "default": "./dist/src/brands/index.js"
    },
    "./home": {
      "types": "./dist/src/home.d.ts",
      "import": "./dist/src/home.js",
      "browser": "./dist/src/home.js",
      "default": "./dist/src/home.js"
    },
    "./index": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "browser": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./phosphor-ssr": {
      "types": "./dist/src/phosphor-ssr.d.ts",
      "import": "./dist/src/phosphor-ssr.js",
      "browser": "./dist/src/phosphor-ssr.js",
      "default": "./dist/src/phosphor-ssr.js"
    },
    "./spinners/index": {
      "types": "./dist/src/spinners/index.d.ts",
      "import": "./dist/src/spinners/index.js",
      "browser": "./dist/src/spinners/index.js",
      "default": "./dist/src/spinners/index.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "import": "./dist/src/types.js",
      "browser": "./dist/src/types.js",
      "default": "./dist/src/types.js"
    },
    "./wc": {
      "types": "./dist/src/wc.d.ts",
      "import": "./dist/src/wc.js",
      "browser": "./dist/src/wc.js",
      "default": "./dist/src/wc.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/**",
    "!dist/**/*.spec.*",
    "!dist/**/*.test.*",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/tests/**",
    "!src/**/test/**",
    "!src/**/__tests__/**",
    "docs/agent-guide.md",
    "llms.txt",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "dependencies": {
    "@iconify-icon/react": "^3.0.4",
    "@iconify/json": "^2.2.540",
    "@iconify/react": "^6.0.2",
    "@iconify/tailwind4": "^1.2.3",
    "@phosphor-icons/react": "^2.1.10",
    "flag-icons": "^7.5.0",
    "flagpack-core": "^2.1.0",
    "react-flagpack": "^2.0.6",
    "react-icons": "^5.7.0",
    "simple-icons": "^16.34.0",
    "unplugin-icons": "^24.0.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "vite": "^7 || ^8"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "arki": {
    "runtimes": [
      "bun",
      "deno",
      "browser"
    ],
    "bundlerOnly": [
      "./spinners"
    ]
  }
}
